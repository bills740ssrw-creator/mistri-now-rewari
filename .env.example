# ---------------------------------------------------------------------------
# Mistri Now Rewari — environment configuration
# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
#
# RUNNING WITHOUT SUPABASE:
#   Leave NEXT_PUBLIC_DEMO_MODE=true and the app runs on a local file-backed
#   demo store (.data/demo.json) with seeded customers, workers and bookings.
#   Demo OTP is 123456. This is great for previews — it is NOT production.
#
# PRODUCTION:
#   Set NEXT_PUBLIC_DEMO_MODE=false and provide the three Supabase values
#   below. Then run the SQL in supabase/migrations/ and
#   `pnpm seed:supabase` (needs SUPABASE_SERVICE_ROLE_KEY).
# ---------------------------------------------------------------------------

NEXT_PUBLIC_DEMO_MODE=true

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for metadata + auth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Business details (single source of truth for the UI)
NEXT_PUBLIC_SUPPORT_PHONE=8307121221
NEXT_PUBLIC_UPI_ID=mistrinowrewari@upi

# Secret used to sign the demo session cookie. Change in production demos.
DEMO_SESSION_SECRET=change-me-mistri-now-rewari-demo-secret

# Set to "true" to show the demo-mode banner in the UI.
NEXT_PUBLIC_SHOW_DEMO_BANNER=true
